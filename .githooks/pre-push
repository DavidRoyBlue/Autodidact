#!/bin/sh
# Refuse pushing main; feature branches push normally. Pairs with pre-commit,
# and covers the case the machine-wide permission rules miss: a bare
# `git push` from a checked-out main names no "main" token for them to match.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha> per ref being pushed.

status=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/master)
		echo "refusing to push main: land it through a PR." >&2
		echo "See AGENTS.md, \"Changing the system\"." >&2
		status=1
		;;
	esac
done

exit "$status"
