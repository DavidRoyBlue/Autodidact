{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bkd/.local/bin/uvx code-review-graph@2.3.9 update --skip-flows >/dev/null 2>&1",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/suggest-plan-review.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/issuekit/cli.mjs sync"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/first-prompt-issue.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bkd/.local/bin/uvx code-review-graph@2.3.9 update --skip-flows >/dev/null 2>&1; test -f .code-review-graph/graph.db && echo 'code-review-graph: index ready. Call get_minimal_context_tool(task=...) first; Grep for a single lookup, the graph for callers, impact and tests (AGENTS.md \"Code graph\", skill explore-codebase).'",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bkd/.local/bin/uvx code-review-graph@2.3.9 enrich",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/bkd/Projects/Autodidact/.claude/hooks/session-issues.mjs"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "code-review-graph"
  ]
}
