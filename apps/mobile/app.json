{
  "expo": {
    "name": "Autodidact",
    "slug": "autodidact",
    "version": "1.0.0",
    "scheme": "autodidact",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autodidact.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.autodidact.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000/v1",
      "supabaseUrl": "https://cbzdsoojfhpsexuyeyxt.supabase.co",
      "supabasePublishableKey": "sb_publishable_4gQJJhMvmf_jvbbKVTRdCQ_INqqcIdH",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e474adad-9236-4737-8347-a4cd474db980"
      }
    },
    "owner": "davidroyblue"
  }
}
