# Autodidact GCP bootstrap inputs — copy to infra/secrets.env and fill in.
#   cp infra/secrets.env.example infra/secrets.env   # then edit
# infra/secrets.env is gitignored — it holds real secret values. Never commit it.
#
# Consumed by scripts/gcp-bootstrap.sh, which creates the Secret Manager secrets
# and generates infra/environments/prod/terraform.tfvars. Secret NAMES are fixed
# by infra/environments/prod/main.tf — only the values below change.
#
# Also the single prod-secret source for local prod-DB access: the migrate:prod
# and db:studio:prod scripts load this file directly, so DATABASE_URL must be the
# transaction-pooler URL (port 6543).

# ── Project / region ─────────────────────────────────────────────────────────
PROJECT_ID="autodidact-494819"        # the Project ID, not display name (e.g. autodidact-494819)
REGION="northamerica-northeast1"         # must match infra/environments/prod/variables.tf default (Montreal, co-located with Supabase ca-central-1)
GITHUB_REPO="DavidRoyBlue/Autodidact"    # owner/repo — used for Workload Identity Federation

# ── Real secrets (handle carefully; never commit) ────────────────────────────
# DATABASE_URL: Supabase → Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL="postgresql://...pooler...:6543/postgres"
# SUPABASE_URL: Supabase → Settings → API → Project URL
SUPABASE_URL="https://YOURREF.supabase.co"
# SUPABASE_SECRET_KEY: Supabase → Settings → API → secret key (admin; never ships to clients)
SUPABASE_SECRET_KEY="your-supabase-secret-key"
# OPENAI_API_KEY: OpenAI platform → API keys
OPENAI_API_KEY="sk-..."

# ── Config stored as secrets (sane defaults; change only if you know why) ─────
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"  # placeholder until telemetry is wired
API_PORT="8080"             # Cloud Run routes traffic to 8080
AGENT_PORT="8080"
LLM_PROVIDER="openai"
EMBEDDING_PROVIDER="openai"
AUTH_PROVIDER="supabase"
CHECKPOINTER="postgres"
QUEUE_PROVIDER="cloudtasks"  # the switch that activates the Cloud Tasks path in prod (ADR-027)

# ── Chicken-and-egg URLs ─────────────────────────────────────────────────────
# These Cloud Run URLs don't exist until the first deploy. Leave as placeholders;
# the script seeds them and Step 6 of docs/gcp_infra_setup.md fills the real values.
AGENT_SERVICE_URL="https://placeholder"
WORKER_TASK_BASE_URL="https://placeholder"
