# =============================================================================
# AUTODIDACT — ENVIRONMENT VARIABLES
# Copy this file to .env.dev (pnpm setup does this automatically).
#
# With direnv installed, `.envrc` loads .env.dev automatically for every command
# run in this directory (see .envrc.example). Without direnv, env is injected by
# the `dotenv -e` wrappers in package.json (pnpm dev / migrate:* / db:*).
#
# This file is for LOCAL DEV only. There is no .env.prod: in production, secrets
# live in GCP Secret Manager (seeded from infra/secrets.env) and Cloud Run injects
# them at container startup. The prod-DB wrappers (migrate:prod / db:studio:prod)
# read infra/secrets.env directly.
#
# Variables are grouped by who reads them. The "RESERVED / NOT READ AT RUNTIME"
# section at the bottom lists vars kept for infra or future use — setting them
# has no effect on the running services today.
# =============================================================================


# ── RUNTIME ───────────────────────────────────────────────────────────────────
# Read by @autodidact/observability (logger). Both optional with safe defaults.

# Options: development | production | test   (default: development)
NODE_ENV=development
# Pino level: fatal | error | warn | info | debug | trace | silent   (default: info)
LOG_LEVEL=info


# ── LOCAL DATABASE + SUPABASE ────────────────────────────────────────────────
# Local dev runs the full Supabase stack via `supabase start` (pnpm dev starts it).
# Connect DIRECT to the local stack — no pooler locally. The port-6543 transaction
# pooler is required only for the CLOUD/prod DATABASE_URL (cloud direct host is
# IPv6-only and unreachable from WSL2; 127.0.0.1 is reachable directly).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Production / WSL2 pooler example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres

SUPABASE_URL=http://127.0.0.1:55321

# Run `pnpm exec supabase status` after `supabase start` and copy the two keys here.
SUPABASE_PUBLISHABLE_KEY=
# (also read by the mobile app via app.config.ts for local-stack auth)
# Secret key — server-side admin client (packages/db) only; never expose to clients
SUPABASE_SECRET_KEY=


# ── AI PROVIDERS ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY is required (agent). ANTHROPIC_API_KEY is required only if you
# set LLM_PROVIDER=anthropic.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── OBSERVABILITY (OPTIONAL) ──────────────────────────────────────────────────
# Leave blank to silently drop traces. Set to a Grafana/Honeycomb OTLP endpoint
# to enable. The service name is set in code (initTracer), not via env.

OTEL_EXPORTER_OTLP_ENDPOINT=


# ── PROVIDER SELECTION ────────────────────────────────────────────────────────
# Only these three switches are wired to code today. Production overrides live in
# GCP Secret Manager. CHECKPOINTER must be "postgres" in production
# (set via the autodidact-checkpointer secret).

# Options: openai | anthropic   (agent — packages/providers)
LLM_PROVIDER=openai
# Options: memory | postgres     (agent — postgres requires DATABASE_URL)
CHECKPOINTER=memory
# Options: loopback | cloudtasks   (api + worker — packages/providers)
# loopback: enqueue POSTs straight to the worker's /tasks endpoint (local dev).
# cloudtasks: GCP Cloud Tasks — requires GCP_PROJECT_ID, CLOUD_TASKS_LOCATION,
# WORKER_TASK_BASE_URL, CLOUD_TASKS_INVOKER_SA (production; set via Secret Manager).
QUEUE_PROVIDER=loopback


# ── INTER-SERVICE URLS (LOCAL DEV) ────────────────────────────────────────────

AGENT_SERVICE_URL=http://localhost:3001
API_PORT=3000
AGENT_PORT=3001
WORKER_PORT=3002
# Where enqueued tasks are POSTed (loopback locally; the worker Cloud Run URL in prod)
WORKER_TASK_BASE_URL=http://localhost:3002


# ── RESERVED / NOT READ AT RUNTIME ────────────────────────────────────────────
# Kept for infrastructure (Terraform/GCP) or reserved for not-yet-implemented
# provider switches. Setting these has NO effect on the running services today —
# the provider factories hardcode the single implemented option. Listed here so
# the template documents them without implying they are wired.

# Infra only (Terraform / GCP deploy), not read by any service at runtime:
# GCP_REGION=northamerica-northeast1
# DATABASE_URL_DIRECT=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Cloud Tasks (QUEUE_PROVIDER=cloudtasks only — production; unset for local dev):
# GCP_PROJECT_ID=
# CLOUD_TASKS_LOCATION=northamerica-northeast1
# CLOUD_TASKS_INVOKER_SA=autodidact-run@[project].iam.gserviceaccount.com

# Reserved provider switches — the factory ignores these (one option implemented):
# EMBEDDING_PROVIDER=openai     # createEmbeddingProvider hardcodes OpenAI
# AUTH_PROVIDER=supabase        # createAuthProvider hardcodes Supabase

# Mobile social sign-in (Phase 1)
GOOGLE_WEB_CLIENT_ID=
FACEBOOK_ENABLED=false
# Local Supabase Google provider (supabase/config.toml env() substitution).
# Dummy is fine: signInWithIdToken validates via Google JWKS, no secret needed.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=dev-dummy-not-used
