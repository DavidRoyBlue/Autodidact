# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.expo/
*.tsbuildinfo

# Compiled TS output accidentally emitted into src/ (build output belongs in dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
services/*/src/**/*.js
services/*/src/**/*.js.map
services/*/src/**/*.d.ts
services/*/src/**/*.d.ts.map

# Turbo
.turbo/

# Environment
.env
.env.dev
.env.prod
.env.local
.env.*.local
.envrc.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
postgres-data/
redis-data/

# Terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/.terraform.lock.hcl
infra/**/terraform.tfvars

# GCP bootstrap inputs — real secret values (see infra/secrets.env.example)
infra/secrets.env

# Git worktrees
.worktrees/

# Python virtual environment
.venv/

# direnv — personal config is ignored; the committed template (.envrc.example) is tracked
.envrc
!.envrc.example

# EAS / Expo
.expo-shared/

# Generated architecture graphs
docs/architecture/graphs/*.svg

# GitHub Actions workflow changes may require a personal access token with the
# `workflow` scope when pushing to GitHub.
# Added by code-review-graph
.code-review-graph/
.claude/worktrees/

# Android signing keystores (EAS credential backups) — never commit
*.jks
*.keystore

# Expo managed workflow: native dirs are generated; committing them flips EAS to bare workflow
apps/mobile/android/
apps/mobile/ios/
